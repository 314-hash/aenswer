# Public site domain
NEXT_PUBLIC_SITE_URL=https://aenswer.ph

# Optional webhook for automated inquiry alerts (e.g. n8n workflow or Discord webhook)
# If left empty, inquiries will be validated, logged, and return a reference ID safely.
INQUIRY_WEBHOOK_URL=

# Official business contact address
CONTACT_RECEIVER_EMAIL=inquiries@aenswer.ph

# Environment mode
NODE_ENV=development
